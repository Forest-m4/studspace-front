diff --git a/internal/transport/api/handlers/booking_applicant_test.go b/internal/transport/api/handlers/booking_applicant_test.go
new file mode 100644
index 0000000..599a093
--- /dev/null
+++ b/internal/transport/api/handlers/booking_applicant_test.go
@@ -0,0 +1,38 @@
+package handlers
+
+import (
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+
+	"github.com/kr0uch/studspace/internal/core/models/api"
+	"github.com/kr0uch/studspace/internal/core/models/dto"
+	"github.com/kr0uch/studspace/internal/core/models/entities"
+	"github.com/kr0uch/studspace/pkg/web"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/mock"
+	"github.com/stretchr/testify/require"
+)
+
+func TestBookingController_CreateBookingWithApplicant(t *testing.T) {
+	user := testHandlerUser()
+	bookings := new(mockBookingService)
+	spaces := new(mockBookingSpaceService)
+	bookings.On("CreateBooking", mock.Anything, *user, mock.MatchedBy(func(in dto.CreateBooking) bool {
+		return in.FirstName != nil && *in.FirstName == "Мария" && in.LastName != nil && *in.LastName == "Петрова"
+	}), mock.Anything).Return(&entities.Booking{BookingID: 10, SpaceID: 1, FirstName: "Мария", LastName: "Петрова"}, nil)
+	spaces.On("GetSpaceByID", mock.Anything, int16(1)).Return(&entities.Space{SpaceID: 1, Name: "A"}, nil)
+	request := httptest.NewRequest(http.MethodPost, "/bookings", strings.NewReader(`{"space_id":1,"first_name":"Мария","last_name":"Петрова","title":"Учёба","purpose":"учёба","people_count":2,"starts_at":"2099-12-01T15:00:00+03:00","ends_at":"2099-12-01T16:00:00+03:00"}`))
+	request = request.WithContext(web.ContextWithUser(request.Context(), user))
+	response := httptest.NewRecorder()
+	err := NewBookingController(bookings, spaces, new(mockBookingUserService)).CreateBookingHandler(response, request)
+	require.NoError(t, err)
+	assert.Equal(t, http.StatusCreated, response.Code)
+	var booking api.Booking
+	require.NoError(t, json.NewDecoder(response.Body).Decode(&booking))
+	assert.Equal(t, "Мария", booking.FirstName)
+	assert.Equal(t, "Петрова", booking.LastName)
+	bookings.AssertExpectations(t)
+}
