@@ -0,0 +1,69 @@
+package service
+
+import (
+	"context"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/kr0uch/studspace/internal/core/models/dto"
+	"github.com/kr0uch/studspace/internal/core/models/entities"
+	"github.com/kr0uch/studspace/pkg/errors"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/mock"
+)
+
+func TestBookingService_CreateBookingApplicant(t *testing.T) {
+	text := func(value string) *string { return &value }
+	for _, tc := range []struct {
+		name                string
+		first, last         *string
+		wantFirst, wantLast string
+		invalid             bool
+	}{
+		{name: "legacy request uses VK names", wantFirst: "Иван", wantLast: "Иванов"},
+		{name: "edited names belong only to booking", first: text(" Мария "), last: text(" Петрова-Соколова "), wantFirst: "Мария", wantLast: "Петрова-Соколова"},
+		{name: "one omitted name keeps its profile value", first: text("Мария"), wantFirst: "Мария", wantLast: "Иванов"},
+		{name: "empty first name", first: text("  "), invalid: true},
+		{name: "empty last name", last: text("  "), invalid: true},
+		{name: "long Unicode name", first: text(strings.Repeat("Я", 101)), invalid: true},
+		{name: "Unicode boundary", first: text(strings.Repeat("Я", 100)), wantFirst: strings.Repeat("Я", 100), wantLast: "Иванов"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			ctx := context.Background()
+			actor := testStudent()
+			profile := actor
+			hall := testHall()
+			now := time.Date(2026, 11, 1, 10, 0, 0, 0, time.UTC)
+			starts, ends := tomorrowSlot(now)
+			spaces := new(mockSpaceRepository)
+			bookings := new(mockBookingRepository)
+			users := new(mockUserRepository)
+			spaces.On("GetSpaceByID", ctx, hall.SpaceID).Return(&hall, nil)
+			if !tc.invalid {
+				bookings.On("CountPendingBookingsByUser", ctx, actor.UserID, now).Return(0, nil)
+				bookings.On("ListOverlappingBookings", ctx, hall.SpaceID, starts, ends, (*int64)(nil)).Return([]entities.Booking{}, nil)
+				bookings.On("CreateBooking", ctx, mock.MatchedBy(func(booking entities.Booking) bool {
+					return booking.UserID == actor.UserID && booking.FirstName == tc.wantFirst && booking.LastName == tc.wantLast
+				})).Return(&entities.Booking{BookingID: 10, FirstName: tc.wantFirst, LastName: tc.wantLast}, nil)
+			}
+			got, err := NewBookingService(bookings, spaces, users, new(mockNotifyRepository)).CreateBooking(ctx, actor, dto.CreateBooking{
+				SpaceID: hall.SpaceID, StartsAt: starts, EndsAt: ends, Title: "Учёба", Purpose: "учёба", PeopleCount: 2,
+				FirstName: tc.first, LastName: tc.last,
+			}, now)
+			if tc.invalid {
+				assert.ErrorIs(t, err, errors.ErrValidation)
+				assert.Nil(t, got)
+				bookings.AssertNotCalled(t, "CreateBooking", mock.Anything, mock.Anything)
+			} else {
+				assert.NoError(t, err)
+				assert.Equal(t, tc.wantFirst, got.FirstName)
+				assert.Equal(t, tc.wantLast, got.LastName)
+			}
+			assert.Equal(t, profile, actor)
+			assert.Empty(t, users.Calls)
+			spaces.AssertExpectations(t)
+			bookings.AssertExpectations(t)
+		})
+	}
+}
