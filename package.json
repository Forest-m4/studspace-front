{
  "name": "studspace-front",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "gen:api": "swagger2openapi ../studspace/docs/swagger.yaml --outfile .openapi.json && openapi-typescript .openapi.json -o src/shared/api/schema.d.ts",
    "sign:params": "node --env-file-if-exists=.env.local scripts/sign-launch-params.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@vkontakte/vk-bridge": "^3.0.2",
    "lucide-react": "^1.70.0",
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "openapi-typescript": "^7.13.0",
    "oxlint": "^1.89.0",
    "postcss": "^8.5.32",
    "swagger2openapi": "^7.0.8",
    "typescript": "~5.9",
    "vite": "^8.3.5"
  }
}
